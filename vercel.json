{
  "rewrites": [
    { "source": "/api/trips", "destination": "/api/trip-proxy" },
    { "source": "/api/trips/:path*", "destination": "/api/trip-proxy?path=:path*" },
    { "source": "/api/auth/:path*", "destination": "/api/auth-proxy?path=:path*" },
    { "source": "/app", "destination": "/app/dist/index.html" },
    { "source": "/app/((?!dist/).*)", "destination": "/app/dist/index.html" }
  ]
}
